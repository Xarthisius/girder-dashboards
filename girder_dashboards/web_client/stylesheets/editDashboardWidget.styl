@import "variables"

#g-dashboard-edit-form
  // This form has enough fields to outgrow a short viewport. Bootstrap 3 scrolls
  // the whole modal in that case, which pushes the title and the Save button off
  // screen; scrolling the body instead keeps both anchored at any window height.
  .modal-body
    max-height calc(100vh - 190px)
    overflow-y auto

  .g-dashboard-field-help
    margin 4px 0 0
    font-size 12px
    color $dashboardMuted

  .g-dashboard-settings-input
    font-family Menlo, Monaco, Consolas, monospace
    font-size 12px

  .modal-footer
    .g-dashboard-reset
      float left
