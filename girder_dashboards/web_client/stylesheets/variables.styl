// Shared tokens for the dashboards UI. Values are chosen to sit alongside
// Girder's Bootstrap 3 theme rather than to introduce a second visual language.
$dashboardBorder = #dcdcdc
$dashboardMuted = #6b7480
$dashboardInk = #33383d
$dashboardAccent = #3d7fbf
$dashboardSurface = #ffffff
$dashboardCanvas = #f4f6f8
$dashboardWarning = #a8620b

$dashboardRadius = 4px
$dashboardShadow = 0 1px 2px rgba(0, 0, 0, 0.08)
$dashboardShadowHover = 0 4px 12px rgba(0, 0, 0, 0.14)

$dashboardTopbarHeight = 48px
