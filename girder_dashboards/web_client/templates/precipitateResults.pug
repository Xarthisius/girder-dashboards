mixin statsRows(stats)
  each row in stats.rows
    tr
      th= row.label
      td.g-precip-num= row.diameterPx
      td.g-precip-num= row.diameterNm
      td.g-precip-num= row.spacingPx
      td.g-precip-num= row.spacingNm

.g-precip-results
  .g-precip-tiles
    each tile in tiles
      .g-precip-tile
        .g-precip-tile-value= tile.value
        .g-precip-tile-unit= tile.unit
        .g-precip-tile-label= tile.label

  .g-precip-panel
    .g-precip-panel-header
      h4 Distributions
      .g-precip-panel-tools
        label(for="g-precip-scope") Region
        select#g-precip-scope.form-control.input-sm
          each option in scopes
            option(value=option.value selected=option.selected)= option.label
    .g-precip-panel-body
      .g-precip-chart-grid
        .g-precip-chart
          .g-precip-chart-title Precipitate size distribution
          .g-precip-chart-canvas
            canvas#g-precip-diameter-chart
        .g-precip-chart
          .g-precip-chart-title= spacingTitle
          .g-precip-chart-canvas
            canvas#g-precip-spacing-chart
      .g-precip-chart.g-precip-chart-wide
        .g-precip-chart-title Spacing map
        .g-precip-chart-note Every detected particle at its position in the micrograph, coloured by its nearest-neighbour spacing.
        .g-precip-chart-canvas.g-precip-map-canvas
          canvas#g-precip-map-chart
        .g-precip-colorbar
          span.g-precip-colorbar-label= colorbar.min
          each band in colorbar.bands
            span.g-precip-colorbar-band(style=`background: ${band.color}` title=band.title)
          span.g-precip-colorbar-label= colorbar.max
          span.g-precip-colorbar-caption spacing (nm)

  .g-precip-panel
    .g-precip-panel-header
      h4= statsTitle
      span.g-precip-panel-note= statsNote
    .g-precip-panel-body.g-precip-panel-body-flush
      table.table.g-precip-table
        thead
          tr
            th(rowspan=2) Statistic
            th.g-precip-num(colspan=2) Equivalent diameter, d
            th.g-precip-num(colspan=2)= spacingHeader
          tr
            th.g-precip-num px
            th.g-precip-num nm
            th.g-precip-num px
            th.g-precip-num nm
        tbody
          +statsRows(stats)

  if regions.length > 1
    .g-precip-panel
      .g-precip-panel-header
        h4 Regions
        span.g-precip-panel-note Each region is detected and measured on its own, then pooled.
      .g-precip-panel-body.g-precip-panel-body-flush
        table.table.g-precip-table
          thead
            tr
              th Region
              th.g-precip-num Particles
              th.g-precip-num d mean ± sd (nm)
              th.g-precip-num s mean ± sd (nm)
              th.g-precip-num Size (px)
          tbody
            each region in regions
              tr
                td= region.label
                td.g-precip-num= region.n
                td.g-precip-num= region.diameter
                td.g-precip-num= region.spacing
                td.g-precip-num= region.area

  .g-precip-results-footer
    span.g-precip-muted= provenance
    span
      if resultUrl
        a.g-precip-download(href=resultUrl download="results.json")
          i.icon-download
          |  results.json
      if folderUrl
        a.g-precip-download(href=folderUrl)
          i.icon-folder-open
          |  Open run folder
